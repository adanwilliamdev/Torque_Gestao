# Copie para .env (docker-compose) ou exporte as variáveis no ambiente.
ENVIRONMENT=development

# Banco de dados (PostgreSQL). Em produção use uma senha forte.
DB_URL=jdbc:postgresql://localhost:5432/torque
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (opcional: sem ele a aplicação segue funcionando, sem cache e sem rate limit)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT da API REST. Em produção: 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=troque-este-segredo-em-producao-para-uma-string-longa-e-aleatoria
# Access token curto (15 min); a sessão é renovada via /api/auth/refresh
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_DAYS=7

# Origens permitidas na API (CORS), separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:8080

LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
DASHBOARD_CACHE_TTL_SECONDS=30
APP_TIMEZONE=America/Sao_Paulo

# Administrador inicial (criado na primeira inicialização, se não existir)
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@torquegestao.com
# Vazio = senha aleatória gerada e exibida uma vez no log (apenas fora de produção)
SEED_ADMIN_PASSWORD=
